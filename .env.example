# Topic Hot 的配置。复制成 .env 再改；密钥不要提交到 Git。
# GitHub Actions 里不需要这个文件：在仓库 Settings → Secrets and variables → Actions 里配置同名变量。

# 网站对外的地址：GitHub Pages 部署后是 https://<用户名>.github.io/<仓库名>/
SITE_URL=http://localhost:4173

# ===== 模型（可选）=====
# 不填 LLM_API_KEY 时，整条管线自动降级为纯规则模式（关键词打分 + 摘要截取），照样能跑。
# 任何 OpenAI 兼容接口都可以。下面是 DeepSeek 的写法：
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 服务商特有的请求参数（JSON），比如关掉思考模式：
# LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 其他服务商的例子：
#   千问      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   智谱      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash
# 服务不支持 JSON 模式（response_format）时关掉：
# LLM_JSON_MODE=false

# ===== 选填 =====
# 本机抓海外信源要走代理时（GitHub Actions 不需要）：
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 调试时允许访问内网地址（默认 false，不要在生产打开）：
# ALLOW_PRIVATE_FETCH=false
